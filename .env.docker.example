# Copy to .env.docker and fill in real values, then:
#   docker compose --env-file .env.docker up -d --build
# or, on the VPS:
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build
#
# .env.docker is gitignored — never commit real secrets.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=yhconnect
POSTGRES_USER=yhconnect
POSTGRES_PASSWORD=change-me-to-a-real-password

# --- Backend ------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Local/dev defaults (docker-compose.yml); on the VPS (docker-compose.prod.yml)
# set these to your real domain instead, e.g.:
#   BACKEND_CORS_ORIGINS=["https://yourdomain.example"]
#   FRONTEND_BASE_URL=https://yourdomain.example
#   PUBLIC_BASE_URL=https://yourdomain.example
#   NEXT_PUBLIC_API_URL=https://yourdomain.example/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# One-off bootstrap endpoint (/api/v1/internal/seed) used to create the
# first admin account. Set to a random string, use it once, then clear it
# again to close the door.
SEED_SECRET=

KYC_ENFORCEMENT_ENABLED=false

# --- Email (optional — leave blank to have emails log to console instead) ---
RESEND_API_KEY=
EMAIL_FROM=YH Connect <no-reply@yhconnect.ng>
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587

# --- Monnify (optional — leave blank to simulate payments/NIN verification) -
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
