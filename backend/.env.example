# Copy this file to .env and adjust values.

# Postgres (recommended for production):
# DATABASE_URL=postgresql+psycopg2://yhconnect:yhconnect@localhost:5432/yhconnect
# Falls back to a local SQLite file if not set — fine for local dev/demo.
DATABASE_URL=sqlite:///./yhconnect.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# NIN identity verification (client + professional KYC) runs through Monnify's
# Verification API using the same MONNIFY_* credentials below — no separate
# key needed. Leave those unset for local dev: NIN verification runs in
# simulated mode (any well-formed 11-digit NIN is treated as a match). Monnify's
# NIN endpoint has no sandbox — it's Live-environment only, and each successful
# check costs ₦60.

# Client KYC is currently NOT enforced (invites/messages/bid-acceptance work
# without verification) while the rest of the platform is still being built.
# Flip to true once ready to require KYC again.
KYC_ENFORCEMENT_ENABLED=false

# Transactional email (password reset, email verification, notifications).
# Leave unset for local dev: emails are logged to the console instead of sent.
# Preferred provider is Resend — set RESEND_API_KEY and EMAIL_FROM must use a
# domain verified in your Resend account.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=YH Connect <no-reply@yhconnect.ng>

# SMTP fallback (only used if RESEND_API_KEY isn't set) — any SMTP provider.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Base URL of the deployed frontend, used to build links in emails.
FRONTEND_BASE_URL=http://localhost:3000
